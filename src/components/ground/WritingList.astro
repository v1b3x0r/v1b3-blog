---
import { getCollection } from "astro:content";

// Newest three, by date alone. Gating this on `featured` meant every new post
// stayed off the homepage until someone remembered to flip the flag.
const posts = (await getCollection("posts", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);
---

{posts.length > 0 && (
  <section id="writing" class="ground-writing" aria-labelledby="writing-title">
    <h2 id="writing-title" class="ground-writing-title">writing</h2>
    <ol class="writing-list">
      {posts.map((post) => {
        const published = post.data.publishedAt.toISOString().slice(0, 10);
        return (
          <li>
            <a class="writing-row" href={`/writing/${post.id}/`}>
              <time class="writing-date" datetime={published}>{published}</time>
              <span class="writing-name">{post.data.title}</span>
              <span class="writing-desc">{post.data.summary}</span>
              <span class="writing-minutes">{post.data.readingMinutes} MIN</span>
            </a>
          </li>
        );
      })}
    </ol>
    <a class="ground-writing-all" href="/writing/">all writing →</a>
  </section>
)}
