---
import { ClientRouter } from "astro:transitions";
import Analytics from "@vercel/analytics/astro";
import { ListeningDock } from "../components/audio/ListeningDock";
import "../styles/ambient-radio.css";
import "../styles/listening-dock.css";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  pageClass?: string;
}

const {
  title = "v1b3topia",
  description = "building v1b3topia, somewhere in chiang mai. small systems by 97's INTP guy.",
  pageClass = "",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <ClientRouter />
    <Analytics />
  </head>
  <body class={pageClass}>
    <a href="#main" class="skip-link">skip to content</a>
    <ListeningDock client:load transition:persist />
    <slot />
    <footer class="site-footer">
      <p>from chiang mai · with melancholy</p>
      <nav class="site-footer__links" aria-label="find v1b3 elsewhere">
        <span>elsewhere</span>
        <a href="https://github.com/v1b3x0r" target="_blank" rel="me noreferrer">
          github <span aria-hidden="true">↗</span>
        </a>
        <a href="https://www.linkedin.com/in/v1b3x0r/" target="_blank" rel="me noreferrer">
          linkedin <span aria-hidden="true">↗</span>
        </a>
        <a href="mailto:v1b3@getsquish.app?subject=hello%20from%20v1b3.io">
          email <span aria-hidden="true">↗</span>
        </a>
      </nav>
    </footer>
  </body>
</html>
