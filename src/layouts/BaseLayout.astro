---
import { ClientRouter } from "astro:transitions";
import Analytics from "@vercel/analytics/astro";
import { ListeningDock } from "../components/audio/ListeningDock";
import "../styles/ambient-radio.css";
import "../styles/listening-dock.css";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  pageClass?: string;
  /** Absolute URL of the share card. Omitted pages get a text-only card, not a wrong one. */
  image?: string;
  imageAlt?: string;
  ogType?: "website" | "article";
}

const {
  title = "v1b3topia",
  description = "building v1b3topia, somewhere in chiang mai. small systems by 97's INTP guy.",
  pageClass = "",
  image,
  imageAlt,
  ogType = "website",
} = Astro.props;

// Astro.site is set in astro.config.mjs; canonical points at the www host the
// apex redirects to, so shared links do not carry a redirect.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="v1b3topia" />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image ? (
      <>
        <meta property="og:image" content={image} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:image" content={image} />
      </>
    ) : (
      <meta name="twitter:card" content="summary" />
    )}
    <ClientRouter />
    <Analytics />
  </head>
  <body class={pageClass}>
    <a href="#main" class="skip-link">skip to content</a>
    <ListeningDock client:load transition:persist />
    <slot />
    <footer class="site-footer">
      <p>from chiang mai · with melancholy</p>
      <nav class="site-footer__links" aria-label="find v1b3 elsewhere">
        <span>elsewhere</span>
        <a href="https://github.com/v1b3x0r" target="_blank" rel="me noreferrer">
          github <span aria-hidden="true">↗</span>
        </a>
        <a href="https://www.linkedin.com/in/v1b3x0r/" target="_blank" rel="me noreferrer">
          linkedin <span aria-hidden="true">↗</span>
        </a>
        <a href="mailto:v1b3019@proton.me?subject=hello%20from%20v1b3.io">
          email <span aria-hidden="true">↗</span>
        </a>
      </nav>
    </footer>
  </body>
</html>
